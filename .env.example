# Google Analytics 4 Measurement ID (leave blank to disable analytics)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Your live site's URL. Leave blank while developing locally — the code falls back to
# https://zeal-global-exports.vercel.app automatically. Once you deploy to Vercel, check
# your actual assigned URL (Vercel may add a suffix like -yourname.vercel.app if the plain
# name is taken) and set it here. Later, when you buy a real domain, just update this one
# value in Vercel's dashboard (Settings -> Environment Variables) and redeploy — you won't
# need to touch any code files again.
NEXT_PUBLIC_SITE_URL=

# Google Sheets — stores every inquiry as a row in a spreadsheet you own.
# See google-apps-script/Code.gs and the README "Storing Inquiries in Google Sheets"
# section for the full step-by-step setup. Paste the Web App URL you get at the end here.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyuq1fua8Cc_vdFSCaSTw8rvZEwjp2E_SryTII47P-jnXHRlH66iDVxc88s4xw0sN_D/exec

# Resend (https://resend.com) — powers the contact form and newsletter signup emails
# 1. Create a free Resend account and an API key: https://resend.com/api-keys
# 2. Verify a sending domain under Domains (e.g. zealglobalexports.com) — required to send
#    to any recipient. Until verified, Resend only lets you send to your own account email.
# 3. Paste the key below.
RESEND_API_KEY=

# The address inquiries are sent TO (your inbox)
CONTACT_TO_EMAIL=export@zealglobalexports.com

# The address emails are sent FROM — must be on a domain you've verified in Resend,
# or leave as the default test sender below (onboarding@resend.dev) while testing.
CONTACT_FROM_EMAIL=Zeal Global Exports <onboarding@resend.dev>

# Resend Audience ID for newsletter signups (Resend dashboard → Audiences → create one → copy ID)
RESEND_AUDIENCE_ID=
